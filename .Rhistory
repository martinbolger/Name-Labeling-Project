df <- read.csv(file="emendata_analysis_data.csv", header=TRUE, sep=",")
subset_cols = function(df, string){
columns = colnames(df)
indx <- grepl(string, columns)
sub_df = df[indx]
return(sub_df)
}
#Create a sum of the values of complaints, leaving, and care for all years
sub_df_complaints = subset_cols(df, 'complaints')
sub_df_leaving = subset_cols(df, 'leaving')
sub_df_care = subset_cols(df, 'care')
df = mutate(df, complaints = rowSums(sub_df_complaints)/4)
df = mutate(df, leaving = rowSums(sub_df_leaving)/4)
df = mutate(df, care = rowSums(sub_df_care)/4)
#Variance for leaving (this is for measuring how much the rate of people leaving the plan changes over time)
leaving_var = apply(sub_df_leaving,1,var)
df = mutate(df, leaving_var = leaving_var)
#Complaint Variance
complaint_var = apply(sub_df_complaints,1,var)
df = mutate(df, complaint_var = complaint_var)
#Care Variance
care_var = apply(sub_df_care,1,var)
df = mutate(df, care_var = care_var)
# Get the change in complaints for each year and the overall change in complaints
#This will help track the trend for this variable
df = mutate(df, complaint_diff_2017 = df$complaints_2017-df$complaints_2016)
df = mutate(df, complaint_diff_2018 = df$complaints_2018-df$complaints_2017)
df = mutate(df, complaint_diff_2019 = df$complaints_2019-df$complaints_2018)
sub_df_complaint_diff = subset_cols(df, 'complaint_diff')
df = mutate(df, complaint_diff = rowSums(sub_df_complaint_diff))
#Change in percent of customers leaving the plan
df = mutate(df, leave_diff_2017 = df$leaving_2017-df$leaving_2016)
df = mutate(df, leave_diff_2018 = df$leaving_2018-df$leaving_2017)
df = mutate(df, leave_diff_2019 = df$leaving_2019-df$leaving_2018)
sub_df_leave_diff = subset_cols(df, 'leave_diff')
sub_df_leave_diff
df = mutate(df, leave_diff = rowSums(sub_df_leave_diff))
#Change in percent of customers receiving care
df = mutate(df, care_diff_2017 = df$care_2017-df$care_2016)
df = mutate(df, care_diff_2018 = df$care_2018-df$care_2017)
df = mutate(df, care_diff_2019 = df$care_2019-df$care_2018)
sub_df_care_diff = subset_cols(df, 'care_diff')
df = mutate(df, care_diff = rowSums(sub_df_care_diff))
outlier_df <- data.frame(matrix(ncol = ncol(df)+1, nrow = 0))
columns = colnames(df)
colnames(outlier_df) <- c(columns, 'outlier_type')
#Average Complaints per 1000 people
comp_bp = boxplot(df$complaints, main = 'Complaint Box Plot', ylab = 'total complaints')
comp_outlier = df[df$complaints %in% comp_bp$out[which(comp_bp$out > comp_bp$stats[5]*2)],]
comp_outlier = mutate(comp_outlier, outlier_type = rep('complaints', nrow(comp_outlier)))
outlier_df = rbind(outlier_df, comp_outlier)
#Average percent Leaving
leaving_bp = boxplot(df$leaving, main = 'Average Percent Leaving Box Plot', ylab = 'Average Percent Leaving')
leave_outlier = df[df$complaints %in% leaving_bp$out[which(leaving_bp$out > leaving_bp$stats[5]*2)],]
leave_outlier = mutate(leave_outlier, outlier_type = rep('leaving', nrow(leave_outlier)))
outlier_df = rbind(outlier_df, leave_outlier)
#Average percent receiving Care
care_bp = boxplot(df$care, main = 'Average Percent Receiving Care Box Plot', ylab = 'Average Percent Receiving Care')
care_outlier = df[df$care %in% care_bp$out[which(care_bp$out < care_bp$stats[5]*2)],]
care_outlier = mutate(care_outlier, outlier_type = rep('care', nrow(care_outlier)))
outlier_df = rbind(outlier_df, care_outlier)
#Leaving complain
complaint_var_bp = boxplot(df$complaint_var, main = 'Leaving Var Box Plot', ylab = 'Variance in average percent leaving')
complaint_var_outlier = df[df$complaint_var %in% complaint_var_bp$out[which(complaint_var_bp$out > complaint_var_bp$stats[5]*2)],]
complaint_var_outlier = mutate(complaint_var_outlier, outlier_type = rep('complaint_var', nrow(complaint_var_outlier)))
outlier_df = rbind(outlier_df, complaint_var_outlier)
#Leaving variance
