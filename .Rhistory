care_diff_outlier = df[df$care_diff %in% care_diff_bp$out[which(care_diff_bp$out > care_diff_bp$stats[5]*2)],]
care_diff_outlier = mutate(care_diff_outlier, outlier_type = rep('care_diff', nrow(care_diff_outlier)))
