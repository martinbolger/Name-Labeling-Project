leaving_var_outlier = df[df$leaving_var %in% leaving_var_bp$out[which(leaving_var_bp$out > leaving_var_bp$stats[5]*2)],]
leaving_var_outlier = mutate(leaving_var_outlier, outlier_type = rep('leaving_var', nrow(leaving_var_outlier)))
outlier_df = rbind(outlier_df, leaving_var_outlier)
#Care variance
care_var_bp = boxplot(df$care_var, main = 'Care Var Box Plot', ylab = 'Variance in average percent receiving care')
care_var_outlier = df[df$care_var %in% care_var_bp$out[which(care_var_bp$out > care_var_bp$stats[5]*2)],]
care_var_outlier = mutate(care_var_outlier, outlier_type = rep('care_var', nrow(care_var_outlier)))
outlier_df = rbind(outlier_df, care_var_outlier)
#Complaint difference
comp_diff_bp = boxplot(df$complaint_diff, main = 'Complaint Diff Box Plot', ylab = 'Diff in complaints')
comp_diff_outlier = df[df$complaint_diff %in% comp_diff_bp$out[which(comp_diff_bp$out > comp_diff_bp$stats[5]*2)],]
comp_diff_outlier = mutate(comp_diff_outlier, outlier_type = rep('comp_diff', nrow(comp_diff_outlier)))
outlier_df = rbind(outlier_df, comp_diff_outlier)
#Leaving difference
leave_diff_bp = boxplot(df$leave_diff, main = 'Leave Diff Box Plot', ylab = 'Diff in average percent leaving')
leave_diff_outlier = df[df$leave_diff %in% leave_diff_bp$out[which(leave_diff_bp$out > leave_diff_bp$stats[5]*2)],]
leave_diff_outlier = mutate(leave_diff_outlier, outlier_type = rep('leave_diff', nrow(leave_diff_outlier)))
outlier_df = rbind(outlier_df, leave_diff_outlier)
#Care difference
